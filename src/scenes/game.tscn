[sub_resource type="Shader" id="Shader_3rtjt"]
code = "// custom shader to apply fish-eye and grain effects
//
// code from:
// - https://godotshaders.com/shader/fisheye-anti-fisheye-camera-effect/
// - https://godotshaders.com/shader/film-grain-shader/
//
// note:
// 1. calculate the fish-eye current pixel color
// 2. pass the \"final\" pixel color using `vect(col, 1.0)`
// 3. apply grain distortion
shader_type canvas_item;

// todo: doc ?
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

// options
uniform float grain_amount : hint_range(0.0, 1.0) = 0.05;
uniform float grain_size : hint_range(0.1, 10.0) = 1.0;
uniform float grain_time : hint_range(0.0, 10.0) = 1.5;
uniform float fisheye_effect_amount : hint_range(-2.5, 2.5) = 1.6;
uniform float circle_size : hint_range(0.0, 1.05) = 0.6;

/**
 * Noise generator based on manual time management
 * Docs:
 * - https://docs.godotengine.org/en/stable/tutorials/shaders/shader_reference/shader_functions.html#shader-func-dot
 * - https://docs.godotengine.org/en/stable/tutorials/shaders/shader_reference/shader_functions.html#shader-func-sin
 * - https://docs.godotengine.org/en/stable/tutorials/shaders/shader_reference/shader_functions.html#shader-func-fract
 * Notes:
 * - https://godotshaders.com/shader/film-grain-shader/
 */
float _effect_get_noise(vec2 g_UV) {
	return (fract(sin(dot(g_UV * grain_time, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) * 2.0;
}

/**
 * Fish-eye effect.
 * Docs:
 * - https://godotshaders.com/shader/fisheye-anti-fisheye-camera-effect/
 * - https://docs.godotengine.org/en/stable/tutorials/shaders/shader_reference/canvas_item_shader.html
 */
vec4 _effect_fisheye(vec2 g_SCREEN_PIXEL_SIZE, vec4 g_FRAGCOORD) {
	vec2 iResolution = 1.0 / g_SCREEN_PIXEL_SIZE;
	vec2 p = g_FRAGCOORD.xy / iResolution.x;
	float prop = iResolution.x / iResolution.y;
	vec2 m = vec2(0.5, 0.5 / prop);
	vec2 d = p - m;
	float r = sqrt(dot(d, d)); 
	float power = fisheye_effect_amount;
	float bind;
	if (power > 0.0) 
		bind = sqrt(dot(m, m));
	else {
		bind = (prop < 1.0) ? m.x : m.y;
	}
	vec2 uv;
	if (power > 0.0) {
		uv = m + normalize(d) * tan(r * power) * bind / tan( bind * power);
	} else if (power < 0.0) {
		uv = m + normalize(d) * atan(r * -power * 10.0) * bind / atan(-power * bind * 10.0);
	} else {
		uv = p;
	}
    uv.y *= prop;
	return vec4(texture(SCREEN_TEXTURE, uv).rgb,1.0);
}

/**
 * Grain effect
 * Docs:
 * - https://godotshaders.com/shader/film-grain-shader/
 */
vec4 _effect_grain(vec4 pixel, vec2 g_UV) {
	pixel.rgb += _effect_get_noise(g_UV) * grain_amount * grain_size;
	return clamp(pixel, 0.0, 1.0);
}

/**
 * Dark circle effect
 * Docs:
 * - https://docs.godotengine.org/en/stable/tutorials/shaders/shader_reference/shader_functions.html#shader-func-distance
 * - https://docs.godotengine.org/en/stable/tutorials/shaders/shader_reference/shader_functions.html#shader-func-mix
 * - https://docs.godotengine.org/en/stable/tutorials/shaders/shader_reference/shader_functions.html#shader-func-mod
 */
vec4 _effect_circle(vec4 pixel, vec2 g_UV, float g_circle_size) {
	float dist = distance(vec2(0.5, 0.5), vec2(mix(0.5, g_UV.x, 1.0), g_UV.y));
	dist += 0.1 - mod(_effect_get_noise(g_UV), 0.2);
	if (step(g_circle_size, dist) > 0.0) {
		pixel.r = pixel.r / 1.5;
		pixel.g = pixel.g / 1.5;
		pixel.b = pixel.b / 1.5;
	}
	return pixel;
}

void fragment() {
	// FIXME: Disabled because object drag need correct ray tracing (need to be a camera option, not a shader)
	//vec4 pixel = _effect_fisheye(SCREEN_PIXEL_SIZE, FRAGCOORD);
	vec4 pixel = vec4(texture(SCREEN_TEXTURE, UV).rgb,1.0);
	pixel = _effect_circle(pixel, UV, circle_size);
	pixel = _effect_circle(pixel, UV, circle_size + 0.05);
	pixel = _effect_circle(pixel, UV, circle_size + 0.10);
	pixel = _effect_grain(pixel, UV);
	COLOR = pixel;
}
"

