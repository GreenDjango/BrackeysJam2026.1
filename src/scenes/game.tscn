[sub_resource type="GDScript" id="GDScript_covw0"]
script/source = "extends SpringArm3D

@export_range(0., 180., 0.1, \"radians_as_degrees\") var max_y_angle: float = PI/2
@export_range(0., 180., 0.1, \"radians_as_degrees\") var max_x_angle: float = PI/2

func _input(event: InputEvent) -> void:
	if event is InputEventMouseMotion:
		var mouse_offset: Vector2 = (clamp(
			event.global_position / Vector2(get_window().size),
			Vector2.ZERO,
			Vector2.ONE
		) - Vector2(0.5, 0.5)) * 2

		rotation.y = -mouse_offset.x * max_y_angle
		rotation.x = -mouse_offset.y * max_x_angle

		$\"../../CanvasLayer/ScreenFX\".fx_grain_time_update.emit()
"

